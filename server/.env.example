# Copiá este archivo como .env y completá las keys. El .env NO se sube al repo.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
PORT=3060
# Dominios desde los que se puede llamar a la API, separados por coma.
ALLOWED_ORIGINS=https://consultoriadigital.io,https://www.consultoriadigital.io
# Pedidos por hora y por IP. Subilo a 1000 antes de un evento presencial:
# ahí todos salen por el mismo WiFi y comparten una sola IP pública.
MAX_REQUESTS=40
# Envíos del test y logins al panel, también por hora y por IP.
MAX_TESTS=60
MAX_LOGINS=20

# ---- Flujo de n8n: arma el PDF del reporte y lo manda por wasender ----
N8N_WEBHOOK_URL=https://n8n.srv1224751.hstgr.cloud/webhook/cuestionario
# Opcional: si lo cargás, viaja como header X-CD-Token para que n8n valide el origen.
N8N_WEBHOOK_TOKEN=
# Cuánto esperamos la lectura de IA antes de disparar igual (por si cierran la pestaña).
N8N_ESPERA_IA_MS=25000

# ---- Panel /admin ----
# Sin ADMIN_PASSWORD el panel queda deshabilitado. Poné una larga: abre datos de clientes.
ADMIN_PASSWORD=
# Opcional: si no está, se deriva de ADMIN_PASSWORD. Cambiarla invalida las sesiones abiertas.
ADMIN_SECRET=
# Dónde se guardan los tests (relativo a server/). Tiene que ser escribible por pm2.
DATA_DIR=./data
